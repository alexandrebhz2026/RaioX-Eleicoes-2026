{
  "expo": {
    "name": "RAIO-X Eleições 2026",
    "slug": "raio-x-eleicoes-2026",
    "version": "0.3.15",
    "scheme": "raiox2026",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#061329",
    "icon": "./assets/raiox-icon.png",
    "plugins": [
      "@react-native-google-signin/google-signin",
      ["expo-local-authentication", {"faceIDPermission": "Use o Face ID para entrar com segurança no RAIO-X Eleições 2026."}],
      ["expo-secure-store", {"configureAndroidBackup": true, "faceIDPermission": "Use o Face ID para proteger seu acesso rápido ao RAIO-X Eleições 2026."}]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.raiox2026.app",
      "config": {"usesNonExemptEncryption": false}
    },
    "android": {
      "package": "com.raiox2026.app",
      "versionCode": 19,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/raiox-icon.png",
        "backgroundColor": "#061329"
      }
    },
    "androidStatusBar": {"barStyle": "light-content", "backgroundColor": "#061329", "translucent": false},
    "androidNavigationBar": {"backgroundColor": "#07162D", "barStyle": "light-content", "enforceContrast": false}
  }
}
