{
  "expo": {
    "name": "RAIO-X Eleições 2026",
    "slug": "raio-x-eleicoes-2026",
    "version": "0.3.3",
    "scheme": "raiox2026",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-apple-authentication",
      ["expo-local-authentication", {"faceIDPermission": "Permita que o RAIO-X use o Face ID para entrar com mais rapidez e segurança."}],
      "expo-secure-store"
    ],
    "ios": {"supportsTablet": true, "bundleIdentifier": "com.raiox2026.app", "usesAppleSignIn": true},
    "android": {
      "package": "com.raiox2026.app",
      "versionCode": 7,
      "predictiveBackGestureEnabled": false
    },
    "androidNavigationBar": {"backgroundColor": "#07162D", "barStyle": "light-content"}
  }
}
